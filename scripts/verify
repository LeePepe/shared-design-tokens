#!/usr/bin/env bash
# Single verification entry, shared by .githooks/pre-push and CI (quality.yml).
#
#   scripts/verify              contract checks + gates of layers changed vs $VERIFY_BASE (default origin/main)
#   scripts/verify --changed    same as the default
#   scripts/verify --all        contract checks + every layer gate (what CI runs)
#   scripts/verify --layer L    contract checks + one layer's gates
#
# Layer selection and gates come from docs/architecture/tech-context.md through
# the shared-ci resolver at the SHA pinned in AGENTS.md ($SHARED_CI, default
# .shared-ci). Unmapped paths fail; any gate failure fails.
# Prerequisites: Node >=22 with `npm ci` done (scripts/ci/setup.sh), Chrome or
# Chromium (or CHROME_BIN), Swift 6. The Swift consumer gate needs a clean,
# committed working tree.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
# Git hooks export GIT_DIR and friends for this repository. Drop them so the
# .shared-ci init/fetch below targets its own directory, never this repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX

mode="changed"
layer=""
case "${1:-}" in
    ""|--changed) mode="changed" ;;
    --all) mode="all" ;;
    --layer) mode="layer"; layer="${2:?--layer needs a layer name}" ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "[verify] unknown option: $1 (use --changed, --all or --layer L)" >&2; exit 2 ;;
esac

# ---- shared-ci resolver at the pinned SHA -----------------------------------
default_cache="$root/.shared-ci"
shared_ci="${SHARED_CI:-$default_cache}"
pin="$(sed -n 's|.*LeePepe/shared-ci@\([0-9a-f]\{40\}\)/ai/agent-protocol\.md.*|\1|p' AGENTS.md | head -1)"
[ -n "$pin" ] || { echo "[verify] AGENTS.md has no full-SHA shared-ci protocol pointer" >&2; exit 1; }
if [ "$(git -C "$shared_ci" rev-parse HEAD 2>/dev/null || true)" != "$pin" ]; then
    # Only the repository-owned, gitignored cache is ever recreated. A caller-supplied
    # SHARED_CI directory is never deleted; it must already be a checkout at the pin.
    if [ "$shared_ci" != "$default_cache" ]; then
        echo "[verify] SHARED_CI=$shared_ci is not a shared-ci checkout at $pin; refusing to modify it" >&2
        exit 1
    fi
    rm -rf "$default_cache"
    git init -q "$default_cache"
    git -C "$default_cache" fetch -q --depth=1 "${SHARED_CI_URL:-https://github.com/LeePepe/shared-ci.git}" "$pin" \
        || { echo "[verify] cannot fetch shared-ci $pin" >&2; exit 1; }
    git -C "$default_cache" checkout -q --detach FETCH_HEAD
fi
context=(python3 "$shared_ci/scripts/context/_context.py")

contract() {
    echo "[verify] contract audit + workflow-lint (shared-ci ${pin:0:12})"
    "${context[@]}" audit >/dev/null
    python3 "$shared_ci/scripts/lint/workflows.py" --root . >/dev/null
}

run_layer() {
    local gate_mode="local"
    [ "${VERIFY_MODE:-}" = "ci" ] && gate_mode="ci"
    "${context[@]}" run "$1" --mode "$gate_mode"
}

contract
case "$mode" in
    layer)
        run_layer "$layer"
        echo "[verify] ok: $layer" ;;
    all)
        layers="$("${context[@]}" layers --all)"
        for name in $layers; do run_layer "$name"; done
        echo "[verify] ok: all layers ($(echo $layers))" ;;
    changed)
        base="$(git merge-base "${VERIFY_BASE:-origin/main}" HEAD)"
        changed="$(git diff --name-only "$base" HEAD)"
        if [ -z "$changed" ]; then echo "[verify] ok: no changes"; exit 0; fi
        layers="$(printf '%s\n' "$changed" | "${context[@]}" layers --stdin)"
        for name in $layers; do run_layer "$name"; done
        echo "[verify] ok: changed layers: $(echo ${layers:-none})" ;;
esac
