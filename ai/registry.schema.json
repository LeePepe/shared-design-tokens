{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:leepepe:design-tokens:ai-registry:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "documents", "compatibility", "changelog", "tokenSchema", "examples", "surfaces"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "swiftProduct"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "swiftProduct": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}}
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["README", "USAGE", "INTEGRATION", "EXAMPLES", "COMPATIBILITY", "MIGRATION"],
      "properties": {
        "README": {"const": "ai/README.md"}, "USAGE": {"const": "ai/USAGE.md"},
        "INTEGRATION": {"const": "ai/INTEGRATION.md"}, "EXAMPLES": {"const": "ai/EXAMPLES.md"},
        "COMPATIBILITY": {"const": "ai/COMPATIBILITY.md"}, "MIGRATION": {"const": "ai/MIGRATION.md"}
      }
    },
    "compatibility": {"$ref": "#/definitions/path"},
    "changelog": {"$ref": "#/definitions/path"},
    "tokenSchema": {
      "type": "object", "additionalProperties": false, "required": ["version", "source"],
      "properties": {"version": {"type": "string", "minLength": 1}, "source": {"$ref": "#/definitions/path"}}
    },
    "examples": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "language", "doc"], "properties": {
        "id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/definitions/path"},
        "language": {"enum": ["javascript", "typescript", "swift", "json"]}, "doc": {"$ref": "#/definitions/path"}
      }}
    },
    "surfaces": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "format", "sha256", "symbols", "doc"], "properties": {
        "path": {"$ref": "#/definitions/path"}, "format": {"enum": ["javascript", "typescript", "swift", "asset"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "doc": {"$ref": "#/definitions/path"}
      }}
    }
  },
  "definitions": {"path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./#-]*$"}}
}
